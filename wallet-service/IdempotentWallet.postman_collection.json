{
  "info": {
    "name": "Idempotent Wallet (IT3133)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Folder 1 matches requests.http. Run requests in order (or use the Collection Runner). Request 1 creates a fresh wallet and a new runId, so every run uses new idempotency keys."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "transferUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "wallet",
      "value": ""
    },
    {
      "key": "walletA",
      "value": ""
    },
    {
      "key": "walletB",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    },
    {
      "key": "runId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Wallet service: idempotency and failure demos (port 8080)",
      "item": [
        {
          "name": "1. Create a wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "create-{{runId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"ownerName\": \"Pehesara\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"wallet\", pm.response.json().walletId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Top up LKR 10.00 (1000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "topup-{{runId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{wallet}}/topups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{wallet}}",
                "topups"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amountMinor\": 1000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"balanceMinor = 1000\", () => pm.expect(String(pm.response.json().balanceMinor)).to.eql(\"1000\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. SAME request again -> replay, balance unchanged",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "topup-{{runId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{wallet}}/topups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{wallet}}",
                "topups"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amountMinor\": 1000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Idempotent-Replayed is true\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"balanceMinor = 1000\", () => pm.expect(String(pm.response.json().balanceMinor)).to.eql(\"1000\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Same key, DIFFERENT amount -> 422",
